# The controllers' credentials for the agentic MCP start.sh runs (copy to controllers.env, chmod 600; it is not
# committed). One NAME=value per line; agentic_mcp.yaml names the variables each controller uses.
# ONOS_USERNAME=
# ONOS_PASSWORD=
# TPCE_USERNAME=
# TPCE_PASSWORD=

# The agentic MCP's token: with it set, anything that is not a read needs it. CANAH sends the same one
# (start.sh passes it on when CANAH's .env has none).
# AGENTIC_MCP_TOKEN=
